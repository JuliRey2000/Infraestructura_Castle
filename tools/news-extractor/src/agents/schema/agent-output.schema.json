{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "agent-output.schema.json",
  "title": "AgentOutput",
  "description": "Contrato de salida que un agente pluggable emite (stdout/body). El connector lo valida; si falla -> AgentError y degradacion elegante.",
  "type": "object",
  "required": ["schemaVersion", "agentId", "summary"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "agentId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "sentiment": {
      "type": ["object", "null"],
      "required": ["score", "label"],
      "properties": {
        "score": { "type": "number", "minimum": -1, "maximum": 1 },
        "label": { "type": "string", "enum": ["bullish", "neutral", "bearish"] }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "direction"],
        "properties": {
          "label": { "type": "string" },
          "direction": { "type": "string", "enum": ["bullish", "bearish", "neutral"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string" },
          "refs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["itemId"],
        "properties": {
          "itemId": { "type": "string" },
          "why": { "type": "string" },
          "importance": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
