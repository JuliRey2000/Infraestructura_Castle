# ==========================================================================
# news-extractor — Variables de entorno (Castle Capital)
# --------------------------------------------------------------------------
# Copia este archivo a `.env` y rellena tus claves. NUNCA commitees `.env`.
# Los YAML de config jamas guardan secretos: todo secreto se lee de aqui.
# Claves vacias = la fuente correspondiente se omite con un aviso (no rompe).
# ==========================================================================

# --- Fuentes de noticias (todas tienen free tier) ---
# CoinGecko (cripto, 100+ fuentes). https://www.coingecko.com/en/api
COINGECKO_API_KEY=YOUR_COINGECKO_KEY_HERE
# Marketaux (tickers, sentimiento, extraccion de entidades). https://www.marketaux.com
MARKETAUX_API_KEY=YOUR_MARKETAUX_KEY_HERE
# Alpha Vantage (Nasdaq, NEWS_SENTIMENT). https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=YOUR_ALPHAVANTAGE_KEY_HERE
# Finnhub (company + market news, fallback bolsa). https://finnhub.io
FINNHUB_API_KEY=YOUR_FINNHUB_KEY_HERE

# --- Agente IA de referencia (ai-synthesizer) ---
# Anthropic Messages API. https://console.anthropic.com
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
# Modelo a usar para la sintesis diaria (opcional).
# Default: claude-sonnet-4-6 | Opciones: claude-opus-4-8, claude-haiku-4-5-20251001
NEWS_AI_MODEL=claude-sonnet-4-6

# --- Notificacion Telegram (push del brief cada manana) ---
# Crea un bot con @BotFather para obtener el token.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Tu chat id (habla con @userinfobot para obtenerlo).
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE
